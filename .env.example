# ==========================================
# NEXUS AI — Member 1 Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Storage Settings
STORAGE_DIR=./data/documents
MAX_FILE_SIZE_BYTES=104857600

# LLM Provider Configuration
# Options: 'gemini', 'openai', 'ollama', 'deterministic'
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OCR Configuration
# Options: 'auto', 'winrt', 'tesseract', 'mock'
OCR_PROVIDER=auto
OCR_MIN_TEXT_CHARS=40

# Chunking Settings
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
