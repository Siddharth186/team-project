# ==========================================
# NEXUS AI — Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ORCHESTRATOR_PORT=5001
MEMBER2_PORT=3002
DEBUG=false

# Storage Settings
STORAGE_DIR=./data/documents
MAX_FILE_SIZE_BYTES=104857600

# LLM Provider Configuration
# Options: 'ollama', 'gemini', 'openai', 'deterministic'
LLM_PROVIDER=ollama
USE_LOCAL_LLM=true
LOCAL_ONLY=false

# Local Ollama LLM Configuration
# Ollama runtime endpoint (OLLAMA_HOST also accepted as alias)
OLLAMA_BASE_URL=http://localhost:11434

# Model Hardware Tiers:
# - Laptop GPU (4 GB VRAM / 16 GB RAM): qwen2.5:3b (pull via `ollama pull qwen2.5:3b`)
# - Instant offline fallback: tinyllama (pull via `ollama pull tinyllama`)
# - High RAM / GPU (>= 16 GB VRAM): qwen2.5:7b / qwen3.5:9b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=tinyllama
OLLAMA_VERIFIER_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama Context Window & Generation Options
OLLAMA_NUM_CTX=16384
OLLAMA_TEMP_EXTRACTION=0.1
OLLAMA_TEMP_REASONING=0.2
OLLAMA_TEMP_REPORT=0.4

# Google Gemini API (Cloud Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible API (Cloud Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OCR Configuration
# Options: 'auto', 'winrt', 'tesseract', 'mock'
OCR_PROVIDER=auto
OCR_MIN_TEXT_CHARS=40

# Chunking Settings
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
